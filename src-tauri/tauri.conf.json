{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Targum",
  "version": "0.1.2",
  "identifier": "com.meir.targum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Targum",
        "width": 680,
        "height": 420,
        "minWidth": 400,
        "minHeight": 240,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://translate.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
